from std::thread import Thread, ThreadError, scope;

fn increment(value: i32) -> i32 {
    value + 1
}

fn increment_borrowed(value: &mut i32) -> i32 {
    *value += 1;
    *value
}

fn main() -> i32 {
    let started: Result<Thread<i32>, ThreadError> =
        Thread::spawn(increment, 41);
    let thread = match started {
        Ok(value) => value,
        Err(_) => {
            return 0;
        },
    };
    let threaded = match thread.join() {
        Ok(value) => value,
        Err(_) => {
            return 0;
        },
    };
    let mut local = 1;
    let scoped = match scope(increment_borrowed, &mut local) {
        Ok(value) => value,
        Err(_) => {
            return 0;
        },
    };
    if threaded == 42 && scoped == 2 && local == 2 {
        42
    } else {
        0
    }
}
