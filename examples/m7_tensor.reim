from std::alloc import general_allocator;
from std::tensor import tensor;

fn main() -> i32 {
    let allocator = general_allocator();
    let shape: [usize; 2] = [1, 2];
    let mut left: tensor<f32, 2> =
        match tensor::zeros(&allocator, shape) {
            Ok(value) => value,
            Err(_) => {
                return 1;
            },
        };
    defer left.deinit();
    let mut right: tensor<f32, 2> =
        match tensor::zeros(&allocator, shape) {
            Ok(value) => value,
            Err(_) => {
                return 2;
            },
        };
    defer right.deinit();
    let mut output: tensor<f32, 2> =
        match tensor::zeros(&allocator, shape) {
            Ok(value) => value,
            Err(_) => {
                return 3;
            },
        };
    defer output.deinit();

    left[0, 0] = 20.0;
    right[0, 0] = 22.0;
    {
        let mut output_view = output.view_mut();
        output_view[0, 1] = 7.0;
    }
    match tensor::add_into(&left, &right, &mut output) {
        Ok(_) => (),
        Err(_) => {
            return 5;
        },
    }

    {
        let view = output.view();
        let view_shape = view.shape();
        let view_strides = view.strides();
        if view_shape[0] != 1 {
            return 60;
        }
        if view_shape[1] != 2 {
            return 61;
        }
        if view_strides[0] != 2 {
            return 62;
        }
        if view_strides[1] != 1 {
            return 63;
        }
        if view[0, 0] == 42.0 { 42 } else { 8 }
    }
}
