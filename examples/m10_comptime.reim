@derive(Copy, Clone, Debug, Eq, Hash, Default)
@align(16)
struct Header {
    kind: u32,
    length: u32,
}

comptime fn factorial(value: usize) -> usize {
    if value <= 1 {
        1
    } else {
        value * factorial(value - 1)
    }
}

const TABLE_SIZE: usize = factorial(5);
const HEADER_SIZE: usize = size_of<Header>();

comptime {
    assert(TABLE_SIZE == 120);
    assert(HEADER_SIZE == 16);
    assert(align_of<Header>() == 16);
    assert(meta::name<Header>() == "Header");
    assert(meta::fields<Header>()[0].name == "kind");
    assert(meta::variants<Option<i32>>()[0] == "Some");
}

@test
fn default_header_should_be_zeroed() {
    let actual = Header::default();
    let expected = Header { kind: 0, length: 0 };
    if actual != expected {
        panic("derived Default produced an unexpected header");
    }
}

fn main() -> i32 {
    let header = Header::default();
    let copied = header.clone();
    if header == copied {
        TABLE_SIZE as i32
    } else {
        0
    }
}
