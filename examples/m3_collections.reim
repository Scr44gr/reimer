from std::alloc import general_allocator;
from std::collections import HashMap, HashSet, RingBuffer;

fn main() -> i32 {
    let allocator = general_allocator();
    let numbers = "123\n";
    let mut map: HashMap<i32, i32> =
        HashMap::new(&allocator).expect("map allocation must succeed");
    defer map.deinit();
    map.insert(1, 20).expect("map insertion must succeed");

    let mut set: HashSet<i32> = HashSet::with_capacity(&allocator, 4)
        .expect("set allocation must succeed");
    defer set.deinit();
    if !set.is_empty() || set.capacity() < 4 {
        return 9;
    }
    set.reserve(16).expect("set growth must succeed");
    set.insert(7).expect("set insertion must succeed");

    let mut ring: RingBuffer<i32> = RingBuffer::with_capacity(&allocator, 2)
        .expect("ring buffer allocation must succeed");
    defer ring.deinit();
    ring.push(1).expect("ring buffer insertion must succeed");
    ring.push(21).expect("ring buffer insertion must succeed");
    ring.push(22).expect("ring buffer growth must succeed");

    let mapped = match map.get(1) {
        Some(value) => value,
        None => 0,
    };
    let present = if set.contains(7) { 1 } else { 0 };
    let buffered = match ring.get(1) {
        Some(value) => value,
        None => 0,
    };
    let removed = match map.remove(1) {
        Some(20) => 1,
        Some(_) => 0,
        None => 0,
    };
    mapped - present + buffered + removed
}
