from std::alloc import AllocError, Allocator, OwnedBytes, allocate_bytes;
import std::slice as slice;

const CONTROL_EMPTY: u8 = 0x80;
const CONTROL_DELETED: u8 = 0xfe;
const CONTROL_GROUP_WIDTH: usize = 16;

@link("runtime")
extern "C" {
    fn control_group_masks(
        controls: *const u8,
        capacity: usize,
        start: usize,
        fingerprint: u8,
    ) -> u64;
    fn hash_seed() -> u64;
    fn copy_bytes(
        destination: *mut u8,
        source: *const u8,
        length: usize,
    ) -> i32;
}

pub struct Vec<T> {
    storage: OwnedBytes,
    data: *mut T,
    len: usize,
}

impl<T> Vec<T> {
    /// Creates an empty vector without an allocation or failure path.
    pub fn empty(allocator: &Allocator) -> Vec<T> {
        Vec {
            storage: OwnedBytes::empty(allocator),
            data: 0 as usize as *mut T,
            len: 0,
        }
    }

    pub fn new(allocator: &Allocator) -> Result<Vec<T>, AllocError> {
        Ok(Vec::empty(allocator))
    }

    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
    ) -> Result<Vec<T>, AllocError> {
        let empty = 0 as usize as *mut T;
        let stride = __pointee_stride(empty);
        let byte_capacity = capacity * stride;
        let mut storage = allocate_bytes(allocator, byte_capacity)?;
        let data = storage.as_mut_ptr() as *mut T;
        Ok(Vec {
            storage: storage,
            data: data,
            len: 0,
        })
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn capacity(&self) -> usize {
        self.storage.len() / __pointee_stride(self.data)
    }

    /// Returns bytes currently reserved for element storage.
    ///
    /// This excludes allocator metadata and is intended for capacity planning,
    /// diagnostics, and benchmark accounting.
    pub fn allocated_bytes(&self) -> usize {
        self.storage.len()
    }

    /// Ensures that `additional` elements fit without another allocation.
    pub fn reserve(&mut self, additional: usize) -> Result<(), AllocError> {
        let required = match self.len.checked_add(additional) {
            Some(value) => value,
            None => {
                return Err(AllocError::OutOfMemory);
            },
        };
        let stride = __pointee_stride(self.data);
        let capacity = self.storage.len() / stride;
        if required <= capacity {
            return Ok(());
        }
        let mut next_capacity = if capacity < 4 as usize {
            4 as usize
        } else {
            capacity
        };
        while next_capacity < required {
            let remaining = required - next_capacity;
            let growth = if remaining > next_capacity {
                remaining
            } else {
                next_capacity
            };
            next_capacity = match next_capacity.checked_add(growth) {
                Some(value) => value,
                None => required,
            };
        }
        let byte_capacity = next_capacity * stride;
        self.storage.grow(byte_capacity)?;
        self.data = self.storage.as_mut_ptr() as *mut T;
        Ok(())
    }

    /// Removes every element while retaining allocated capacity.
    pub fn clear(&mut self)
    where
        T: Copy,
    {
        self.len = 0;
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn as_slice(&self) -> &[T] {
        __slice_from_parts(self.data as *const T, self.len)
    }

    pub fn as_mut_slice(&mut self) -> &mut [T] {
        __slice_from_parts(self.data, self.len)
    }

    pub fn push(&mut self, value: T) -> Result<(), AllocError> {
        self.reserve(1)?;
        let offset = self.len * __pointee_stride(self.data);
        let destination = (self.data as usize + offset) as *mut T;
        unsafe {
            *destination = value;
        }
        self.len += 1;
        Ok(())
    }

    pub fn push_within_capacity(&mut self, value: T) -> bool {
        let stride = __pointee_stride(self.data);
        let capacity = self.storage.len() / stride;
        if self.len == capacity {
            false
        } else {
            let offset = self.len * stride;
            let destination = (self.data as usize + offset) as *mut T;
            unsafe {
                *destination = value;
            }
            self.len += 1;
            true
        }
    }

    /// Inserts one `Copy` value at `index`, shifting later values right.
    ///
    /// Returns `false` when `index` is greater than the current length.
    pub fn insert(
        &mut self,
        index: usize,
        value: T,
    ) -> Result<bool, AllocError>
    where
        T: Copy,
    {
        if index > self.len {
            return Ok(false);
        }
        if index == self.len {
            self.push(value)?;
            return Ok(true);
        }
        self.reserve(1)?;
        let previous_last = match self.get(self.len - 1) {
            Some(existing) => existing,
            None => panic("vector insert could not read its last value"),
        };
        if !self.push_within_capacity(previous_last) {
            panic("reserved vector insertion capacity was unavailable")
        }
        let mut cursor = self.len - 1;
        while cursor > index {
            let previous = match self.get(cursor - 1) {
                Some(existing) => existing,
                None => panic("vector insert shift escaped initialized storage"),
            };
            if !self.set(cursor, previous) {
                panic("vector insert shift escaped initialized storage")
            }
            cursor -= 1;
        }
        if !self.set(index, value) {
            panic("vector insert target escaped initialized storage")
        }
        Ok(true)
    }

    /// Removes one `Copy` value, shifting later values left.
    pub fn remove(&mut self, index: usize) -> Option<T>
    where
        T: Copy,
    {
        let removed = match self.get(index) {
            Some(value) => value,
            None => { return None; },
        };
        let mut cursor = index;
        while cursor + 1 < self.len {
            let next = match self.get(cursor + 1) {
                Some(value) => value,
                None => panic("vector remove shift escaped initialized storage"),
            };
            if !self.set(cursor, next) {
                panic("vector remove shift escaped initialized storage")
            }
            cursor += 1;
        }
        self.len -= 1;
        Some(removed)
    }

    pub fn get(&self, index: usize) -> Option<T>
    where
        T: Copy,
    {
        if index < self.len {
            let offset = index * __pointee_stride(self.data);
            let source = (self.data as usize + offset) as *const T;
            Some(unsafe { *source })
        } else {
            None
        }
    }

    /// Borrows an element without copying or transferring ownership.
    pub fn get_ref(&self, index: usize) -> Option<&T> {
        if index < self.len {
            Some(&self.as_slice()[index])
        } else {
            None
        }
    }

    /// Mutably borrows an element without transferring ownership.
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        if index < self.len {
            Some(&mut self.as_mut_slice()[index])
        } else {
            None
        }
    }

    pub fn set(&mut self, index: usize, value: T) -> bool
    where
        T: Copy,
    {
        if index < self.len {
            let offset = index * __pointee_stride(self.data);
            let destination = (self.data as usize + offset) as *mut T;
            unsafe {
                *destination = value;
            }
            true
        } else {
            false
        }
    }

    pub fn pop(&mut self) -> Option<T>
    where
        T: Copy,
    {
        if self.len == 0 {
            None
        } else {
            self.len -= 1;
            let offset = self.len * __pointee_stride(self.data);
            let source = (self.data as usize + offset) as *const T;
            Some(unsafe { *source })
        }
    }

    pub fn deinit(self) {
        self.storage.deinit();
    }

    /// Releases element storage in place and makes repeated cleanup a no-op.
    pub fn release(&mut self) {
        self.storage.release();
        self.data = 0 as usize as *mut T;
        self.len = 0;
    }

}

impl Vec<u8> {
    /// Copies a borrowed byte sequence into initialized vector storage.
    pub fn write_bytes(&mut self, offset: usize, source: &[u8]) -> bool {
        let source_len = slice::len(source);
        if offset > self.len || source_len > self.len - offset {
            return false;
        }
        let destination = (self.data as usize + offset) as *mut u8;
        let status = unsafe {
            copy_bytes(destination, slice::bytes_as_ptr(source), source_len)
        };
        status == 0
    }

    /// Copies two non-overlapping initialized regions within this vector.
    pub fn copy_nonoverlapping(
        &mut self,
        destination: usize,
        source: usize,
        length: usize,
    ) -> bool {
        if destination > self.len
            || source > self.len
            || length > self.len - destination
            || length > self.len - source
        {
            return false;
        }
        let destination_end = destination + length;
        let source_end = source + length;
        if length != 0
            && destination < source_end
            && source < destination_end
        {
            return false;
        }
        let destination_ptr =
            (self.data as usize + destination) as *mut u8;
        let source_ptr = (self.data as usize + source) as *const u8;
        let status = unsafe {
            copy_bytes(destination_ptr, source_ptr, length)
        };
        status == 0
    }
}

struct Entry<K, V> {
    key: K,
    value: V,
}

impl<K: Copy, V: Copy> Copy for Entry<K, V> {}

struct HashTable<K, V> {
    storage: OwnedBytes,
    entries: *mut Entry<K, V>,
    controls: *mut u8,
    capacity: usize,
}

impl<K: Copy, V: Copy> HashTable<K, V> {
    pub fn empty(allocator: &Allocator) -> HashTable<K, V> {
        HashTable {
            storage: OwnedBytes::empty(allocator),
            entries: 0 as usize as *mut Entry<K, V>,
            controls: 0 as usize as *mut u8,
            capacity: 0,
        }
    }

    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
        probe: *const Entry<K, V>,
    ) -> Result<HashTable<K, V>, AllocError> {
        let entries_bytes = capacity * __pointee_stride(probe);
        let mut storage = allocate_bytes(allocator, entries_bytes + capacity)?;
        let entries = storage.as_mut_ptr() as *mut Entry<K, V>;
        let controls = (storage.as_mut_ptr() as usize + entries_bytes) as *mut u8;
        let mut index: usize = 0;
        while index < capacity {
            unsafe {
                *((controls as usize + index) as *mut u8) = CONTROL_EMPTY;
            }
            index += 1;
        }
        Ok(HashTable {
            storage: storage,
            entries: entries,
            controls: controls,
            capacity: capacity,
        })
    }

    pub fn capacity(&self) -> usize {
        self.capacity
    }

    pub fn set_control(&mut self, index: usize, control: u8) {
        if index >= self.capacity {
            panic("hash table control index is out of bounds")
        } else {
            unsafe {
                *((self.controls as usize + index) as *mut u8) = control;
            }
        }
    }

    pub fn read(&self, index: usize) -> Entry<K, V> {
        if index >= self.capacity {
            panic("hash table entry index is out of bounds")
        }
        let offset = index * __pointee_stride(self.entries);
        let source = (self.entries as usize + offset) as *const Entry<K, V>;
        unsafe { *source }
    }

    pub fn write(&mut self, index: usize, entry: Entry<K, V>) {
        if index >= self.capacity {
            panic("hash table entry index is out of bounds")
        }
        let offset = index * __pointee_stride(self.entries);
        let destination = (self.entries as usize + offset) as *mut Entry<K, V>;
        unsafe {
            *destination = entry;
        }
    }

    pub fn find_index(&self, key: K, hash: u64) -> Option<usize>
    where
        K: Eq,
    {
        let capacity = self.capacity;
        if capacity == 0 {
            return None;
        }
        let mask = capacity - 1;
        let fingerprint = hash_fingerprint(hash);
        let mut start = hash as usize & mask;
        let mut scanned: usize = 0;
        while scanned < capacity {
            let masks = unsafe {
                control_group_masks(
                    self.controls as *const u8,
                    capacity,
                    start,
                    fingerprint,
                )
            };
            let mut matching = masks as u16;
            while matching != 0 {
                let lane = first_control_lane(matching);
                let index = (start + lane) & mask;
                let offset = index * __pointee_stride(self.entries);
                let source =
                    (self.entries as usize + offset) as *const Entry<K, V>;
                if (unsafe { *source }).key == key {
                    return Some(index);
                }
                matching = matching & (matching - 1);
            }
            if ((masks >> 16) as u16) != 0 {
                return None;
            }
            scanned += CONTROL_GROUP_WIDTH;
            start = (start + scanned) & mask;
        }
        None
    }

    pub fn probe(&self, key: K, hash: u64) -> ProbeResult
    where
        K: Eq,
    {
        let capacity = self.capacity;
        let mask = capacity - 1;
        let fingerprint = hash_fingerprint(hash);
        let mut start = hash as usize & mask;
        let mut scanned: usize = 0;
        let mut first_deleted: usize = 0;
        let mut has_deleted = false;
        while scanned < capacity {
            let masks = unsafe {
                control_group_masks(
                    self.controls as *const u8,
                    capacity,
                    start,
                    fingerprint,
                )
            };
            let mut matching = masks as u16;
            while matching != 0 {
                let lane = first_control_lane(matching);
                let index = (start + lane) & mask;
                let offset = index * __pointee_stride(self.entries);
                let source =
                    (self.entries as usize + offset) as *const Entry<K, V>;
                if (unsafe { *source }).key == key {
                    return ProbeResult::Existing(index);
                }
                matching = matching & (matching - 1);
            }
            if !has_deleted {
                let deleted = (masks >> 32) as u16;
                if deleted != 0 {
                    first_deleted =
                        (start + first_control_lane(deleted)) & mask;
                    has_deleted = true;
                }
            }
            let empty = (masks >> 16) as u16;
            if empty != 0 {
                return if has_deleted {
                    ProbeResult::Vacant(first_deleted, true)
                } else {
                    ProbeResult::Vacant(
                        (start + first_control_lane(empty)) & mask,
                        false,
                    )
                };
            }
            scanned += CONTROL_GROUP_WIDTH;
            start = (start + scanned) & mask;
        }
        if has_deleted {
            ProbeResult::Vacant(first_deleted, true)
        } else {
            panic("hash table probe exhausted every control slot")
        }
    }

    pub fn rehash(
        &mut self,
        allocator: &Allocator,
        seed: u64,
        capacity: usize,
    ) -> Result<(), AllocError>
    where
        K: Hash,
    {
        let replacement_result: Result<HashTable<K, V>, AllocError> =
            HashTable::with_capacity(
                allocator,
                capacity,
                0 as usize as *const Entry<K, V>,
            );
        let mut replacement = replacement_result?;
        let mut index: usize = 0;
        while index < self.capacity {
            let control = unsafe {
                *((self.controls as usize + index) as *const u8)
            };
            if control < CONTROL_EMPTY {
                let old_offset = index * __pointee_stride(self.entries);
                let old_source =
                    (self.entries as usize + old_offset) as *const Entry<K, V>;
                let entry = unsafe { *old_source };
                let hash = __hash_value(entry.key, seed);
                let mask = capacity - 1;
                let fingerprint = hash_fingerprint(hash);
                let mut start = hash as usize & mask;
                let mut scanned: usize = 0;
                let mut inserted = false;
                while scanned < capacity && !inserted {
                    let masks = unsafe {
                        control_group_masks(
                            replacement.controls as *const u8,
                            capacity,
                            start,
                            fingerprint,
                        )
                    };
                    let empty = (masks >> 16) as u16;
                    if empty != 0 {
                        let destination_index =
                            (start + first_control_lane(empty)) & mask;
                        let offset = destination_index
                            * __pointee_stride(replacement.entries);
                        let destination = (replacement.entries as usize + offset)
                            as *mut Entry<K, V>;
                        unsafe {
                            *destination = entry;
                            *((replacement.controls as usize + destination_index)
                                as *mut u8) = fingerprint;
                        }
                        inserted = true;
                    }
                    scanned += CONTROL_GROUP_WIDTH;
                    start = (start + scanned) & mask;
                }
                if !inserted {
                    panic("hash table rehash could not find an empty control slot")
                }
            }
            index += 1;
        }
        let entries = replacement.entries;
        let controls = replacement.controls;
        let installed_capacity = replacement.capacity;
        self.storage.replace(replacement.storage);
        self.entries = entries;
        self.controls = controls;
        self.capacity = installed_capacity;
        Ok(())
    }

    pub fn deinit(self) {
        self.storage.deinit();
    }

    pub fn release(&mut self) {
        self.storage.release();
        self.entries = 0 as usize as *mut Entry<K, V>;
        self.controls = 0 as usize as *mut u8;
        self.capacity = 0;
    }
}

enum ProbeResult {
    Existing(usize),
    Vacant(usize, bool),
}

/// A flat hash table with grouped control metadata and explicit cleanup.
///
/// Keys and values are stored by value and therefore currently require
/// `Copy`. Keys must also provide structural `Eq` and `Hash` behavior.
pub struct HashMap<K, V> {
    allocator: Allocator,
    table: HashTable<K, V>,
    len: usize,
    deleted: usize,
    seed: u64,
}

impl<K: Copy + Eq + Hash, V: Copy> HashMap<K, V> {
    /// Creates an empty map without an allocation or failure path.
    pub fn empty(allocator: &Allocator) -> HashMap<K, V> {
        HashMap {
            allocator: *allocator,
            table: HashTable::empty(allocator),
            len: 0,
            deleted: 0,
            seed: unsafe { hash_seed() },
        }
    }

    /// Creates an empty map without allocating entry storage.
    pub fn new(
        allocator: &Allocator,
    ) -> Result<HashMap<K, V>, AllocError> {
        Ok(HashMap::empty(allocator))
    }

    /// Creates an empty map sized for at least `capacity` entries.
    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
    ) -> Result<HashMap<K, V>, AllocError> {
        let table = HashTable::with_capacity(
            allocator,
            table_capacity_for_entries(capacity),
            0 as usize as *const Entry<K, V>,
        )?;
        Ok(HashMap {
            allocator: *allocator,
            table: table,
            len: 0,
            deleted: 0,
            seed: unsafe { hash_seed() },
        })
    }

    /// Returns the number of stored key-value pairs.
    pub fn len(&self) -> usize {
        self.len
    }

    /// Returns how many entries fit before the table must grow.
    pub fn capacity(&self) -> usize {
        maximum_entries(self.table.capacity())
    }

    /// Returns `true` when the map contains no entries.
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    /// Returns the value associated with `key`, if present.
    pub fn get(&self, key: K) -> Option<V> {
        let hash = __hash_value(key, self.seed);
        match self.table.find_index(key, hash) {
            Some(index) => Some(self.table.read(index).value),
            None => None,
        }
    }

    /// Returns `true` when `key` is present.
    pub fn contains_key(&self, key: K) -> bool {
        let hash = __hash_value(key, self.seed);
        match self.table.find_index(key, hash) {
            Some(_) => true,
            None => false,
        }
    }

    /// Ensures that `additional` more keys fit without another allocation.
    pub fn reserve(&mut self, additional: usize) -> Result<(), AllocError> {
        let required = self.len + additional;
        let capacity = self.table.capacity();
        if required > maximum_entries(capacity) {
            self.table.rehash(
                &self.allocator,
                self.seed,
                table_capacity_for_entries(required),
            )?;
            self.deleted = 0;
            Ok(())
        } else if required + self.deleted > maximum_entries(capacity) {
            self.table.rehash(&self.allocator, self.seed, capacity)?;
            self.deleted = 0;
            Ok(())
        } else {
            Ok(())
        }
    }

    /// Inserts or replaces one key-value pair.
    ///
    /// Returns the previous value when the key was already present.
    pub fn insert(
        &mut self,
        key: K,
        value: V,
    ) -> Result<Option<V>, AllocError> {
        let capacity = self.table.capacity();
        if capacity == 0 {
            self.table.rehash(
                &self.allocator,
                self.seed,
                CONTROL_GROUP_WIDTH,
            )?;
            self.deleted = 0;
        } else if self.len + self.deleted + 1 > maximum_entries(capacity) {
            let next_capacity = if self.len + 1 <= maximum_entries(capacity) {
                capacity
            } else {
                capacity * 2
            };
            self.table.rehash(
                &self.allocator,
                self.seed,
                next_capacity,
            )?;
            self.deleted = 0;
        }
        let hash = __hash_value(key, self.seed);
        match self.table.probe(key, hash) {
            ProbeResult::Existing(index) => {
                let previous = self.table.read(index).value;
                self.table.write(index, Entry {
                    key: key,
                    value: value,
                });
                Ok(Some(previous))
            },
            ProbeResult::Vacant(index, reused_deleted) => {
                self.table.write(index, Entry {
                    key: key,
                    value: value,
                });
                self.table.set_control(index, hash_fingerprint(hash));
                self.len += 1;
                if reused_deleted {
                    self.deleted -= 1;
                }
                Ok(None)
            },
        }
    }

    /// Removes `key` and returns its previous value, if present.
    pub fn remove(&mut self, key: K) -> Option<V> {
        let hash = __hash_value(key, self.seed);
        match self.table.find_index(key, hash) {
            Some(index) => {
                let removed = self.table.read(index).value;
                self.table.set_control(index, CONTROL_DELETED);
                self.len -= 1;
                self.deleted += 1;
                Some(removed)
            },
            None => None,
        }
    }

    /// Releases the table storage through its original allocator.
    pub fn deinit(self) {
        self.table.deinit();
    }

    /// Releases table storage in place and makes repeated cleanup inert.
    pub fn release(&mut self) {
        self.table.release();
        self.len = 0;
        self.deleted = 0;
    }
}

fn hash_fingerprint(hash: u64) -> u8 {
    ((hash >> 57) & 0x7f) as u8
}

fn maximum_entries(capacity: usize) -> usize {
    capacity - capacity / 8
}

fn table_capacity_for_entries(entries: usize) -> usize {
    if entries == 0 {
        return 0;
    }
    let mut capacity = CONTROL_GROUP_WIDTH;
    while maximum_entries(capacity) < entries {
        capacity *= 2;
    }
    capacity
}

fn first_control_lane(mask: u16) -> usize {
    let mut remaining = mask;
    let mut lane: usize = 0;
    while (remaining & 1) == 0 {
        remaining = remaining >> 1;
        lane += 1;
    }
    lane
}

/// A collection of unique `Copy + Eq + Hash` values.
pub struct HashSet<T> {
    values: HashMap<T, bool>,
}

impl<T: Copy + Eq + Hash> HashSet<T> {
    /// Creates an empty set without allocating entry storage.
    pub fn new(
        allocator: &Allocator,
    ) -> Result<HashSet<T>, AllocError> {
        let created: Result<HashMap<T, bool>, AllocError> =
            HashMap::new(allocator);
        let values = created?;
        Ok(HashSet { values: values })
    }

    /// Creates an empty set sized for at least `capacity` values.
    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
    ) -> Result<HashSet<T>, AllocError> {
        let created: Result<HashMap<T, bool>, AllocError> =
            HashMap::with_capacity(allocator, capacity);
        let values = created?;
        Ok(HashSet { values: values })
    }

    /// Returns the number of stored values.
    pub fn len(&self) -> usize {
        self.values.len()
    }

    /// Returns how many values fit before the set must grow.
    pub fn capacity(&self) -> usize {
        self.values.capacity()
    }

    /// Returns `true` when the set contains no values.
    pub fn is_empty(&self) -> bool {
        self.values.is_empty()
    }

    /// Returns `true` when `value` is present.
    pub fn contains(&self, value: T) -> bool {
        self.values.contains_key(value)
    }

    /// Ensures that `additional` more values fit without another allocation.
    pub fn reserve(&mut self, additional: usize) -> Result<(), AllocError> {
        self.values.reserve(additional)
    }

    /// Inserts `value`, returning `true` only when it was not already present.
    pub fn insert(
        &mut self,
        value: T,
    ) -> Result<bool, AllocError> {
        match self.values.insert(value, true)? {
            Some(_) => Ok(false),
            None => Ok(true),
        }
    }

    /// Removes `value`, returning `true` when it was present.
    pub fn remove(&mut self, value: T) -> bool {
        match self.values.remove(value) {
            Some(_) => true,
            None => false,
        }
    }

    /// Releases the table storage through its original allocator.
    pub fn deinit(self) {
        self.values.deinit();
    }
}

pub struct RingBuffer<T> {
    values: Vec<T>,
    head: usize,
    len: usize,
    capacity: usize,
}

impl<T: Copy> RingBuffer<T> {
    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
    ) -> Result<RingBuffer<T>, AllocError> {
        let created: Result<Vec<T>, AllocError> =
            Vec::with_capacity(allocator, capacity);
        let values = created?;
        Ok(RingBuffer {
            values: values,
            head: 0,
            len: 0,
            capacity: capacity,
        })
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn push(&mut self, value: T) -> Result<bool, AllocError> {
        if self.capacity == 0 {
            Ok(false)
        } else if self.len < self.capacity {
            self.values.push(value)?;
            self.len += 1;
            Ok(true)
        } else {
            self.values.set(self.head, value);
            self.head = (self.head + 1) % self.capacity;
            Ok(true)
        }
    }

    pub fn get(&self, index: usize) -> Option<T> {
        if index >= self.len {
            None
        } else {
            let physical = (self.head + index) % self.capacity;
            self.values.get(physical)
        }
    }

    pub fn deinit(self) {
        self.values.deinit();
    }
}
