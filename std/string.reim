from std::alloc import AllocError, Allocator, OwnedBytes, allocate_bytes;

pub enum StringError {
    InvalidUtf8,
    LengthExceedsCapacity,
}

/// Compiler-owned marker carried only by an `f"..."` expression.
pub struct FormatArgs {
    marker: (),
}

/// Formatting into an owned string can fail only when its allocator fails.
pub type FormatError = AllocError;

pub struct String {
    bytes: OwnedBytes,
    len: usize,
}

@link("runtime")
extern "C" {
    fn copy_bytes(
        destination: *mut u8,
        source: *const u8,
        len: usize,
    ) -> i32;
    fn utf8_is_valid(data: *const u8, len: usize) -> bool;
    fn buffer_equals(
        left: *const u8,
        left_len: usize,
        right: *const u8,
        right_len: usize,
    ) -> bool;
    fn text_format_f32(
        value: f32,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn text_format_f64(
        value: f64,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn text_format_i128(
        value: *const u8,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn text_format_u128(
        value: *const u8,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn utf8_encode_char(
        value: u32,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn unicode_lowercase(
        value: u32,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn unicode_uppercase(
        value: u32,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn unicode_is_alphabetic(value: u32) -> bool;
    fn unicode_is_alphanumeric(value: u32) -> bool;
    fn unicode_is_numeric(value: u32) -> bool;
    fn unicode_is_whitespace(value: u32) -> bool;
    fn unicode_is_lowercase(value: u32) -> bool;
    fn unicode_is_uppercase(value: u32) -> bool;
    fn unicode_is_control(value: u32) -> bool;
}

impl String {
    /// Creates an empty string with room for at least `capacity` UTF-8 bytes.
    pub fn with_capacity(
        allocator: &Allocator,
        capacity: usize,
    ) -> Result<String, AllocError> {
        let bytes = allocate_bytes(allocator, capacity)?;
        Ok(String {
            bytes: bytes,
            len: 0,
        })
    }

    /// Copies one borrowed UTF-8 string into allocator-owned storage.
    pub fn from(
        allocator: &Allocator,
        value: str,
    ) -> Result<String, AllocError> {
        let len = __string_length(value);
        let mut bytes = allocate_bytes(allocator, len)?;
        let status = unsafe {
            copy_bytes(bytes.as_mut_ptr(), __string_data(value), len)
        };
        if status == 0 {
            Ok(String {
                bytes: bytes,
                len: len,
            })
        } else {
            bytes.deinit();
            panic("std::string received invalid bounded byte regions")
        }
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn capacity(&self) -> usize {
        self.bytes.len()
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    pub fn as_str(&self) -> str {
        __str_from_parts(self.bytes.as_ptr(), self.len)
    }

    pub fn matches(&self, value: str) -> bool {
        unsafe {
            buffer_equals(
                self.bytes.as_ptr(),
                self.len,
                __string_data(value),
                __string_length(value),
            )
        }
    }

    pub fn clone_in(
        &self,
        allocator: &Allocator,
    ) -> Result<String, AllocError> {
        String::from(allocator, self.as_str())
    }

    pub fn reserve(
        &mut self,
        additional: usize,
    ) -> Result<(), AllocError> {
        let required = self.len + additional;
        if required <= self.bytes.len() {
            Ok(())
        } else {
            let doubled = self.bytes.len() * 2;
            let next = if doubled > required {
                doubled
            } else {
                required
            };
            self.bytes.grow(next)
        }
    }

    pub fn push_str(
        &mut self,
        value: str,
    ) -> Result<(), AllocError> {
        let appended = __string_length(value);
        let start = self.len;
        let required = start + appended;
        if required > self.bytes.len() {
            let doubled = self.bytes.len() * 2;
            let next = if doubled > required {
                doubled
            } else {
                required
            };
            self.bytes.grow(next)?;
        }
        let pointer = self.bytes.as_mut_ptr();
        let destination = (pointer as usize + start) as *mut u8;
        let status = unsafe {
            copy_bytes(destination, __string_data(value), appended)
        };
        if status == 0 {
            self.len = required;
            Ok(())
        } else {
            panic("std::string received invalid bounded byte regions")
        }
    }

    /// Appends another owned string without consuming it.
    pub fn push_string(
        &mut self,
        value: &String,
    ) -> Result<(), AllocError> {
        self.push_str(value.as_str())
    }

    /// Appends one Unicode scalar encoded as UTF-8.
    pub fn push_char(
        &mut self,
        value: char,
    ) -> Result<(), AllocError> {
        String::reserve(&mut *self, 4)?;
        let destination =
            (self.bytes.as_mut_ptr() as usize + self.len) as *mut u8;
        let written = unsafe {
            utf8_encode_char(value as u32, destination, 4)
        };
        if written < 0 {
            panic("std::string could not encode a valid Unicode scalar")
        } else {
            self.len += written as usize;
            Ok(())
        }
    }

    /// Appends a boolean using `true` or `false`.
    pub fn push_bool(
        &mut self,
        value: bool,
    ) -> Result<(), AllocError> {
        if value {
            self.push_str("true")
        } else {
            self.push_str("false")
        }
    }

    /// Appends an unsigned integer in base ten.
    pub fn push_u128(
        &mut self,
        value: u128,
    ) -> Result<(), AllocError> {
        String::reserve(&mut *self, 64)?;
        let destination =
            (self.bytes.as_mut_ptr() as usize + self.len) as *mut u8;
        let written = unsafe {
            text_format_u128(
                &value as *const u128 as *const u8,
                destination,
                64,
            )
        };
        if written < 0 {
            panic("std::string could not format u128")
        } else {
            self.len += written as usize;
            Ok(())
        }
    }

    /// Appends a signed integer in base ten.
    pub fn push_i128(
        &mut self,
        value: i128,
    ) -> Result<(), AllocError> {
        String::reserve(&mut *self, 64)?;
        let destination =
            (self.bytes.as_mut_ptr() as usize + self.len) as *mut u8;
        let written = unsafe {
            text_format_i128(
                &value as *const i128 as *const u8,
                destination,
                64,
            )
        };
        if written < 0 {
            panic("std::string could not format i128")
        } else {
            self.len += written as usize;
            Ok(())
        }
    }

    /// Appends an unsigned pointer-sized integer in base ten.
    pub fn push_usize(&mut self, value: usize) -> Result<(), AllocError> {
        self.push_u128(value as u128)
    }

    /// Appends an unsigned 64-bit integer in base ten.
    pub fn push_u64(&mut self, value: u64) -> Result<(), AllocError> {
        self.push_u128(value as u128)
    }

    /// Appends an unsigned 32-bit integer in base ten.
    pub fn push_u32(&mut self, value: u32) -> Result<(), AllocError> {
        self.push_u128(value as u128)
    }

    /// Appends an unsigned 16-bit integer in base ten.
    pub fn push_u16(&mut self, value: u16) -> Result<(), AllocError> {
        self.push_u128(value as u128)
    }

    /// Appends an unsigned 8-bit integer in base ten.
    pub fn push_u8(&mut self, value: u8) -> Result<(), AllocError> {
        self.push_u128(value as u128)
    }

    /// Appends a signed pointer-sized integer in base ten.
    pub fn push_isize(&mut self, value: isize) -> Result<(), AllocError> {
        self.push_i128(value as i128)
    }

    /// Appends a signed 64-bit integer in base ten.
    pub fn push_i64(&mut self, value: i64) -> Result<(), AllocError> {
        self.push_i128(value as i128)
    }

    /// Appends a signed 32-bit integer in base ten.
    pub fn push_i32(&mut self, value: i32) -> Result<(), AllocError> {
        self.push_i128(value as i128)
    }

    /// Appends a signed 16-bit integer in base ten.
    pub fn push_i16(&mut self, value: i16) -> Result<(), AllocError> {
        self.push_i128(value as i128)
    }

    /// Appends a signed 8-bit integer in base ten.
    pub fn push_i8(&mut self, value: i8) -> Result<(), AllocError> {
        self.push_i128(value as i128)
    }

    /// Appends a single-precision float using a shortest round-trippable form.
    pub fn push_f32(
        &mut self,
        value: f32,
    ) -> Result<(), AllocError> {
        String::reserve(&mut *self, 64)?;
        let destination =
            (self.bytes.as_mut_ptr() as usize + self.len) as *mut u8;
        let written = unsafe {
            text_format_f32(value, destination, 64)
        };
        if written < 0 {
            panic("std::string could not format f32")
        } else {
            self.len += written as usize;
            Ok(())
        }
    }

    /// Appends a double-precision float using a shortest round-trippable form.
    pub fn push_f64(
        &mut self,
        value: f64,
    ) -> Result<(), AllocError> {
        String::reserve(&mut *self, 64)?;
        let destination =
            (self.bytes.as_mut_ptr() as usize + self.len) as *mut u8;
        let written = unsafe {
            text_format_f64(value, destination, 64)
        };
        if written < 0 {
            panic("std::string could not format f64")
        } else {
            self.len += written as usize;
            Ok(())
        }
    }

    /// Appends every fragment of an interpolated string.
    ///
    /// The compiler expands the `FormatArgs` operand into typed writes. A
    /// `FormatArgs` value cannot be constructed or stored by user code.
    pub fn push_format(
        &mut self,
        arguments: FormatArgs,
    ) -> Result<(), AllocError> {
        panic("push_format must be expanded by the compiler")
    }

    pub fn clear(&mut self) {
        self.len = 0;
    }

    pub fn deinit(self) {
        self.bytes.deinit();
    }
}

/// Safe formatting destination passed to user-defined `Display` code.
pub struct Formatter {
    output: &mut String,
}

impl Formatter {
    /// Appends a borrowed UTF-8 string without consuming it.
    pub fn write_str(
        &mut self,
        value: str,
    ) -> Result<(), AllocError> {
        String::push_str(&mut *self.output, value)
    }

    /// Appends one Unicode scalar value encoded as UTF-8.
    pub fn write_char(
        &mut self,
        value: char,
    ) -> Result<(), AllocError> {
        String::push_char(&mut *self.output, value)
    }

    /// Appends `true` or `false`.
    pub fn write_bool(
        &mut self,
        value: bool,
    ) -> Result<(), AllocError> {
        String::push_bool(&mut *self.output, value)
    }

    /// Appends a signed integer in base ten.
    pub fn write_i128(
        &mut self,
        value: i128,
    ) -> Result<(), AllocError> {
        String::push_i128(&mut *self.output, value)
    }

    /// Appends an unsigned integer in base ten.
    pub fn write_u128(
        &mut self,
        value: u128,
    ) -> Result<(), AllocError> {
        String::push_u128(&mut *self.output, value)
    }

    /// Appends the shortest round-trippable representation of an `f32`.
    pub fn write_f32(
        &mut self,
        value: f32,
    ) -> Result<(), AllocError> {
        String::push_f32(&mut *self.output, value)
    }

    /// Appends the shortest round-trippable representation of an `f64`.
    pub fn write_f64(
        &mut self,
        value: f64,
    ) -> Result<(), AllocError> {
        String::push_f64(&mut *self.output, value)
    }
}

/// Defines the user-facing representation accepted by `f"{value}"`.
pub trait Display {
    /// Writes `self` into the supplied destination without allocating separately.
    fn fmt(
        &self,
        formatter: &mut Formatter,
    ) -> Result<(), AllocError>;
}

/// Defines the developer-facing representation accepted by `f"{value:?}"`.
pub trait Debug {
    /// Writes structural or diagnostic text into the supplied destination.
    fn fmt_debug(
        &self,
        formatter: &mut Formatter,
    ) -> Result<(), AllocError>;
}

/// Appends a value through its statically selected `Display` implementation.
pub fn append_display<T: Display>(
    output: &mut String,
    value: &T,
) -> Result<(), AllocError> {
    let mut formatter = Formatter { output: output };
    (*value).fmt(&mut formatter)
}

/// Appends a value through its statically selected `Debug` implementation.
pub fn append_debug<T: Debug>(
    output: &mut String,
    value: &T,
) -> Result<(), AllocError> {
    let mut formatter = Formatter { output: output };
    (*value).fmt_debug(&mut formatter)
}

/// Allocates one string containing `left` followed by `right`.
pub fn concat(
    allocator: &Allocator,
    left: str,
    right: str,
) -> Result<String, AllocError> {
    let capacity = __string_length(left) + __string_length(right);
    let mut output = String::with_capacity(allocator, capacity)?;
    output.push_str(left)?;
    output.push_str(right)?;
    Ok(output)
}

/// Allocates one string containing three values in order.
pub fn concat3(
    allocator: &Allocator,
    first: str,
    second: str,
    third: str,
) -> Result<String, AllocError> {
    let capacity =
        __string_length(first)
        + __string_length(second)
        + __string_length(third);
    let mut output = String::with_capacity(allocator, capacity)?;
    output.push_str(first)?;
    output.push_str(second)?;
    output.push_str(third)?;
    Ok(output)
}

/// Repeats one borrowed string `count` times.
pub fn repeat(
    allocator: &Allocator,
    value: str,
    count: usize,
) -> Result<String, AllocError> {
    let capacity = __string_length(value) * count;
    let mut output = String::with_capacity(allocator, capacity)?;
    let mut index: usize = 0;
    while index < count {
        output.push_str(value)?;
        index += 1;
    }
    Ok(output)
}

/// Joins owned strings without consuming them.
pub fn join_strings(
    allocator: &Allocator,
    values: &[String],
    separator: str,
) -> Result<String, AllocError> {
    let mut capacity: usize = 0;
    let mut index: usize = 0;
    let values_len = __slice_length(values);
    while index < values_len {
        capacity += values[index].len();
        index += 1;
    }
    if values_len > 1 {
        capacity += __string_length(separator) * (values_len - 1);
    }

    let mut output = String::with_capacity(allocator, capacity)?;
    index = 0;
    while index < values_len {
        if index > 0 {
            output.push_str(separator)?;
        }
        output.push_str(values[index].as_str())?;
        index += 1;
    }
    Ok(output)
}

/// Returns the UTF-8 byte length of a borrowed string.
pub fn byte_len(value: str) -> usize {
    __string_length(value)
}

/// Counts Unicode scalar values rather than UTF-8 bytes.
pub fn char_count(value: str) -> usize {
    let mut count: usize = 0;
    for _ in value.chars() {
        count += 1;
    }
    count
}

/// Reports whether `prefix` appears at the start of `value`.
pub fn starts_with(value: str, prefix: str) -> bool {
    let value_len = __string_length(value);
    let prefix_len = __string_length(prefix);
    if prefix_len > value_len {
        false
    } else {
        unsafe {
            buffer_equals(
                __string_data(value),
                prefix_len,
                __string_data(prefix),
                prefix_len,
            )
        }
    }
}

/// Reports whether `suffix` appears at the end of `value`.
pub fn ends_with(value: str, suffix: str) -> bool {
    let value_len = __string_length(value);
    let suffix_len = __string_length(suffix);
    if suffix_len > value_len {
        false
    } else {
        let start =
            (__string_data(value) as usize + value_len - suffix_len)
            as *const u8;
        unsafe {
            buffer_equals(
                start,
                suffix_len,
                __string_data(suffix),
                suffix_len,
            )
        }
    }
}

/// Finds the first byte offset of `needle` within `value`.
pub fn find(value: str, needle: str) -> Option<usize> {
    let value_len = __string_length(value);
    let needle_len = __string_length(needle);
    if needle_len == 0 {
        Some(0)
    } else if needle_len > value_len {
        None
    } else {
        let mut index: usize = 0;
        while index <= value_len - needle_len {
            let start =
                (__string_data(value) as usize + index) as *const u8;
            let matches = unsafe {
                buffer_equals(
                    start,
                    needle_len,
                    __string_data(needle),
                    needle_len,
                )
            };
            if matches {
                return Some(index);
            }
            index += 1;
        }
        None
    }
}

/// Reports whether `needle` occurs within `value`.
pub fn contains(value: str, needle: str) -> bool {
    match find(value, needle) {
        Some(_) => true,
        None => false,
    }
}

/// Reports whether a byte offset lies on a UTF-8 scalar boundary.
pub fn is_char_boundary(value: str, index: usize) -> bool {
    let len = __string_length(value);
    if index == 0 || index == len {
        true
    } else if index > len {
        false
    } else {
        let byte = value.bytes()[index];
        (byte & 192) != 128
    }
}

/// Allocates the full Unicode lowercase mapping of one scalar.
pub fn to_lowercase(
    allocator: &Allocator,
    value: char,
) -> Result<String, AllocError> {
    let mut output = String::with_capacity(allocator, 12)?;
    let written = unsafe {
        unicode_lowercase(
            value as u32,
            output.bytes.as_mut_ptr(),
            output.bytes.len(),
        )
    };
    if written < 0 {
        output.deinit();
        panic("std::string could not lowercase a valid Unicode scalar")
    } else {
        output.len = written as usize;
        Ok(output)
    }
}

/// Allocates the full Unicode uppercase mapping of one scalar.
pub fn to_uppercase(
    allocator: &Allocator,
    value: char,
) -> Result<String, AllocError> {
    let mut output = String::with_capacity(allocator, 12)?;
    let written = unsafe {
        unicode_uppercase(
            value as u32,
            output.bytes.as_mut_ptr(),
            output.bytes.len(),
        )
    };
    if written < 0 {
        output.deinit();
        panic("std::string could not uppercase a valid Unicode scalar")
    } else {
        output.len = written as usize;
        Ok(output)
    }
}

/// Reports whether a scalar has the Unicode Alphabetic property.
pub fn is_alphabetic(value: char) -> bool {
    unsafe { unicode_is_alphabetic(value as u32) }
}

/// Reports whether a scalar is Unicode alphabetic or numeric.
pub fn is_alphanumeric(value: char) -> bool {
    unsafe { unicode_is_alphanumeric(value as u32) }
}

/// Reports whether a scalar has the Unicode Numeric property.
pub fn is_numeric(value: char) -> bool {
    unsafe { unicode_is_numeric(value as u32) }
}

/// Reports whether a scalar has the Unicode White_Space property.
pub fn is_whitespace(value: char) -> bool {
    unsafe { unicode_is_whitespace(value as u32) }
}

/// Reports whether a scalar has the Unicode Lowercase property.
pub fn is_lowercase(value: char) -> bool {
    unsafe { unicode_is_lowercase(value as u32) }
}

/// Reports whether a scalar has the Unicode Uppercase property.
pub fn is_uppercase(value: char) -> bool {
    unsafe { unicode_is_uppercase(value as u32) }
}

/// Reports whether a scalar is a Unicode control character.
pub fn is_control(value: char) -> bool {
    unsafe { unicode_is_control(value as u32) }
}

pub fn from_initialized_bytes(
    bytes: OwnedBytes,
    len: usize,
) -> Result<String, StringError> {
    if len > bytes.len() {
        bytes.deinit();
        Err(StringError::LengthExceedsCapacity)
    } else {
        let valid = unsafe { utf8_is_valid(bytes.as_ptr(), len) };
        if valid {
            Ok(String {
                bytes: bytes,
                len: len,
            })
        } else {
            bytes.deinit();
            Err(StringError::InvalidUtf8)
        }
    }
}
