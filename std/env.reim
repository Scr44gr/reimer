from std::alloc import Allocator, allocate_bytes;
from std::string import String, from_initialized_bytes;

/// Recoverable process-environment failures.
pub enum EnvError {
    /// An explicit allocator could not reserve the required bytes.
    OutOfMemory,
    /// A native operating-system string is not valid UTF-8.
    NotUnicode,
    /// An environment-variable name is empty or contains `=` or NUL.
    InvalidName,
    /// The operating system could not provide the requested value.
    Failed,
}

/// A lightweight view over the immutable command-line argument list.
///
/// The first value conventionally identifies the source file or executable.
pub struct Arguments {
    count: usize,
}

const NOT_FOUND: isize = -1;
const NOT_UNICODE: isize = -2;
const INVALID_NAME: isize = -5;

@link("runtime")
extern "C" {
    fn environment_argument_count() -> usize;
    fn environment_argument_open(index: usize) -> isize;
    fn environment_variable_open(data: *const u8, len: usize) -> isize;
    fn environment_current_dir_open() -> isize;
    fn environment_current_exe_open() -> isize;
    fn environment_snapshot_len(handle: usize) -> isize;
    fn environment_snapshot_copy(
        handle: usize,
        destination: *mut u8,
        capacity: usize,
    ) -> isize;
    fn environment_snapshot_close(handle: usize) -> i32;
}

fn error_from_status(status: isize) -> EnvError {
    if status == NOT_UNICODE {
        EnvError::NotUnicode
    } else if status == INVALID_NAME {
        EnvError::InvalidName
    } else {
        EnvError::Failed
    }
}

fn close_snapshot(handle: usize) {
    unsafe {
        environment_snapshot_close(handle);
    }
}

fn string_from_snapshot(
    snapshot: isize,
    allocator: &Allocator,
) -> Result<String, EnvError> {
    if snapshot < 0 {
        return Err(error_from_status(snapshot));
    }
    let handle = snapshot as usize;
    let length = unsafe { environment_snapshot_len(handle) };
    if length < 0 {
        close_snapshot(handle);
        return Err(error_from_status(length));
    }
    let byte_length = length as usize;
    let allocation = allocate_bytes(allocator, byte_length);
    let mut bytes = match allocation {
        Ok(bytes) => bytes,
        Err(_) => {
            close_snapshot(handle);
            return Err(EnvError::OutOfMemory);
        },
    };
    let copied = unsafe {
        environment_snapshot_copy(handle, bytes.as_mut_ptr(), byte_length)
    };
    close_snapshot(handle);
    if copied == length {
        match from_initialized_bytes(bytes, byte_length) {
            Ok(value) => Ok(value),
            Err(_) => Err(EnvError::NotUnicode),
        }
    } else {
        bytes.deinit();
        Err(EnvError::Failed)
    }
}

impl Arguments {
    /// Returns the number of captured arguments.
    pub fn len(&self) -> usize {
        self.count
    }

    /// Returns whether no command-line arguments were captured.
    pub fn is_empty(&self) -> bool {
        self.count == 0
    }

    /// Copies one argument into allocator-owned UTF-8 storage.
    pub fn get(
        &self,
        index: usize,
        allocator: &Allocator,
    ) -> Result<Option<String>, EnvError> {
        if index >= self.count {
            Ok(None)
        } else {
            argument(index, allocator)
        }
    }
}

/// Returns a lightweight view over all command-line arguments.
pub fn args() -> Arguments {
    let count = unsafe { environment_argument_count() };
    Arguments { count: count }
}

/// Copies one command-line argument into allocator-owned UTF-8 storage.
pub fn argument(
    index: usize,
    allocator: &Allocator,
) -> Result<Option<String>, EnvError> {
    let opened = unsafe { environment_argument_open(index) };
    if opened == NOT_FOUND {
        Ok(None)
    } else {
        match string_from_snapshot(opened, allocator) {
            Ok(value) => Ok(Some(value)),
            Err(error) => Err(error),
        }
    }
}

/// Reads one environment variable without mutating process-global state.
///
/// `Ok(None)` means that the variable is not set. Child-specific environment
/// changes are available through `std::process::Command`.
pub fn var(
    allocator: &Allocator,
    name: str,
) -> Result<Option<String>, EnvError> {
    let opened = unsafe {
        environment_variable_open(__string_data(name), __string_length(name))
    };
    if opened == NOT_FOUND {
        Ok(None)
    } else {
        match string_from_snapshot(opened, allocator) {
            Ok(value) => Ok(Some(value)),
            Err(error) => Err(error),
        }
    }
}

/// Returns the current working directory as an allocator-owned UTF-8 string.
pub fn current_dir(allocator: &Allocator) -> Result<String, EnvError> {
    string_from_snapshot(unsafe { environment_current_dir_open() }, allocator)
}

/// Returns the running executable path as an allocator-owned UTF-8 string.
pub fn current_exe(allocator: &Allocator) -> Result<String, EnvError> {
    string_from_snapshot(unsafe { environment_current_exe_open() }, allocator)
}
