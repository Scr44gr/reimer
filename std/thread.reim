impl AtomicBool {
    pub fn new(value: bool) -> AtomicBool {
        let bits = if value { 1 as u64 } else { 0 as u64 };
        let raw = unsafe { atomic_create(bits) };
        AtomicBool {
            raw: require_handle(raw),
        }
    }

    pub fn clone(&self) -> AtomicBool {
        let raw = unsafe { atomic_clone((*self).raw) };
        AtomicBool {
            raw: require_handle(raw),
        }
    }

    pub fn load(&self) -> bool {
        let raw = require_handle((*self).raw);
        unsafe { atomic_load(raw) != 0 }
    }

    pub fn store(&self, value: bool) {
        let raw = require_handle((*self).raw);
        let bits = if value { 1 as u64 } else { 0 as u64 };
        require_status(unsafe {
            atomic_store(raw, bits)
        });
    }

    pub fn swap(&self, value: bool) -> bool {
        let raw = require_handle((*self).raw);
        let bits = if value { 1 as u64 } else { 0 as u64 };
        unsafe { atomic_swap(raw, bits) != 0 }
    }

    pub fn compare_exchange(
        &self,
        current: bool,
        replacement: bool,
    ) -> bool {
        let raw = require_handle((*self).raw);
        let current_bits =
            if current { 1 as u64 } else { 0 as u64 };
        let replacement_bits =
            if replacement { 1 as u64 } else { 0 as u64 };
        unsafe {
            atomic_compare_exchange(
                raw,
                current_bits,
                replacement_bits,
            )
        }
    }

    pub fn deinit(&mut self) {
        require_status(unsafe { atomic_destroy((*self).raw) });
        self.raw = 0;
    }
}

impl<T: Copy + Send> ThreadLocal<T> {
    pub fn new(value: T) -> ThreadLocal<T> {
        let raw = __thread_local_create(value);
        ThreadLocal {
            raw: require_handle(raw),
        }
    }

    pub fn clone(&self) -> ThreadLocal<T> {
        let raw = unsafe { thread_local_clone((*self).raw) };
        ThreadLocal {
            raw: require_handle(raw),
        }
    }

    pub fn get(&self) -> T {
        __thread_local_get((*self).raw)
    }

    pub fn set(&self, value: T) {
        __thread_local_set((*self).raw, value);
    }

    pub fn deinit(&mut self) {
        require_status(unsafe { thread_local_destroy((*self).raw) });
        self.raw = 0;
    }
}
