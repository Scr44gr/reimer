pub struct GlobalFunctions {
    pub vkCreateInstance: Option<PFN_vkCreateInstance>,
    pub vkEnumerateInstanceExtensionProperties: Option<PFN_vkEnumerateInstanceExtensionProperties>,
    pub vkEnumerateInstanceLayerProperties: Option<PFN_vkEnumerateInstanceLayerProperties>,
    pub vkEnumerateInstanceVersion: Option<PFN_vkEnumerateInstanceVersion>,
}

impl GlobalFunctions {
    /// Loads global commands without creating an instance.
    pub fn load(resolve: GetInstanceProcAddr) -> GlobalFunctions {
        let instance = 0 as usize as Instance;
        GlobalFunctions {
            vkCreateInstance: load_vkCreateInstance(resolve, instance),
            vkEnumerateInstanceExtensionProperties: load_vkEnumerateInstanceExtensionProperties(resolve, instance),
            vkEnumerateInstanceLayerProperties: load_vkEnumerateInstanceLayerProperties(resolve, instance),
            vkEnumerateInstanceVersion: load_vkEnumerateInstanceVersion(resolve, instance),
        }
    }
}

