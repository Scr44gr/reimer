    /// Releases the shader module.
    pub fn deinit(self) {
        unsafe {
            api::wgpuShaderModuleRelease(self.raw);
        }
    }
}

/// An owning command encoder.
pub struct CommandEncoder {
    raw: types::WGPUCommandEncoder,
}

impl CommandEncoder {
    /// Finishes recording and transfers ownership to a command buffer.
    pub fn finish(self) -> Result<CommandBuffer, Error> {
        let raw = unsafe {
            api::wgpuCommandEncoderFinish(
                self.raw,
                c::null_const<types::WGPUCommandBufferDescriptor>(),
            )
        };
        unsafe {
            api::wgpuCommandEncoderRelease(self.raw);
        }
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(CommandBuffer { raw: raw })
        }
    }

    /// Releases an unfinished encoder.
    pub fn deinit(self) {
        unsafe {
            api::wgpuCommandEncoderRelease(self.raw);
        }
    }
}

/// An owning, finished command buffer.
pub struct CommandBuffer {
    raw: types::WGPUCommandBuffer,
}

impl CommandBuffer {
    /// Returns the borrowed native command-buffer handle.
    pub fn as_raw(&self) -> types::WGPUCommandBuffer {
        self.raw
    }

    /// Releases the command buffer.
    pub fn deinit(self) {
        unsafe {
            api::wgpuCommandBufferRelease(self.raw);
        }
    }
}

/// An owning presentation surface borrowing its instance.
pub struct Surface {
    instance: types::WGPUInstance,
    raw: types::WGPUSurface,
}

impl Surface {
    /// Requests an adapter compatible with this surface.
    pub fn request_adapter(&self) -> Result<Adapter, Error> {
        let options = types::WGPURequestAdapterOptions {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            feature_level: constants::WGPUFeatureLevel_Undefined,
            power_preference: constants::WGPUPowerPreference_Undefined,
            force_fallback_adapter: 0,
            backend_type: constants::WGPUBackendType_Undefined,
            compatible_surface: self.raw,
        };
        request_adapter_from(self.instance, &options)
    }

    /// Configures this surface for rendering and FIFO presentation.
    pub fn configure(
        &mut self,
        device: &Device,
        format: types::WGPUTextureFormat,
        width: u32,
        height: u32,
    ) {
        let config = types::WGPUSurfaceConfiguration {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            device: device.as_raw(),
            format: format,
            usage: constants::WGPUTextureUsage_RenderAttachment,
            width: width,
            height: height,
            view_format_count: 0,
            view_formats: c::null_const<types::WGPUTextureFormat>(),
            alpha_mode: constants::WGPUCompositeAlphaMode_Auto,
            present_mode: constants::WGPUPresentMode_Fifo,
        };
        unsafe {
            api::wgpuSurfaceConfigure(
                self.raw,
                &config as *const types::WGPUSurfaceConfiguration,
            );
        }
    }

    /// Acquires the next presentable texture.
    pub fn acquire(&self) -> Result<SurfaceFrame, Error> {
        let mut texture = types::WGPUSurfaceTexture {
            next_in_chain: c::null<types::WGPUChainedStruct>(),
            texture: c::null<()>(),
            status: 0,
        };
        unsafe {
            api::wgpuSurfaceGetCurrentTexture(
                self.raw,
                &mut texture as *mut types::WGPUSurfaceTexture,
            );
        }
        if texture.status == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal
            || texture.status == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal
        {
            if c::is_null_mut(texture.texture) {
                Err(Error::SurfaceFailed)
            } else {
                unsafe {
                    api::wgpuSurfaceAddRef(self.raw);
                }
                Ok(SurfaceFrame {
                    surface: self.raw,
                    texture: texture.texture,
                    suboptimal: texture.status
                        == constants::WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal,
                })
            }
        } else {
            Err(surface_error(texture.status))
        }
    }

    /// Removes the current device configuration.
    pub fn unconfigure(&mut self) {
        unsafe {
            api::wgpuSurfaceUnconfigure(self.raw);
        }
    }

    /// Returns the borrowed native surface handle.
    pub fn as_raw(&self) -> types::WGPUSurface {
        self.raw
    }

    /// Releases the surface after it has been unconfigured.
    pub fn deinit(self) {
        unsafe {
            api::wgpuSurfaceRelease(self.raw);
            api::wgpuInstanceRelease(self.instance);
        }
    }
}

/// One acquired presentation image.
pub struct SurfaceFrame {
    surface: types::WGPUSurface,
    texture: types::WGPUTexture,
    suboptimal: bool,
}

impl SurfaceFrame {
    /// Reports whether the surface should be reconfigured soon.
    pub fn is_suboptimal(&self) -> bool {
        self.suboptimal
    }

    /// Creates a default view borrowing the frame's texture lifetime.
    pub fn create_view(&self) -> Result<SurfaceTextureView, Error> {
        let raw = unsafe {
            api::wgpuTextureCreateView(
                self.texture,
                c::null_const<types::WGPUTextureViewDescriptor>(),
            )
        };
        if c::is_null_mut(raw) {
            Err(Error::ResourceCreationFailed)
        } else {
            Ok(SurfaceTextureView { raw: raw })
        }
    }

    /// Presents the frame and releases its texture reference.
    pub fn present(self) -> Result<(), Error> {
        let status = unsafe { api::wgpuSurfacePresent(self.surface) };
        unsafe {
            api::wgpuTextureRelease(self.texture);
            api::wgpuSurfaceRelease(self.surface);
        }
        if status == constants::WGPUStatus_Success {
            Ok(())
        } else {
            Err(Error::PresentFailed)
        }
    }

    /// Releases an acquired frame without presenting it.
    pub fn discard(self) {
        unsafe {
            api::wgpuTextureRelease(self.texture);
            api::wgpuSurfaceRelease(self.surface);
        }
    }
}

/// A texture view borrowing an acquired surface frame.
pub struct SurfaceTextureView {
    raw: types::WGPUTextureView,
}

impl SurfaceTextureView {
    /// Returns the borrowed native texture-view handle.
    pub fn as_raw(&self) -> types::WGPUTextureView {
        self.raw
    }

    /// Releases the view before its surface frame is presented.
    pub fn deinit(self) {
        unsafe {
            api::wgpuTextureViewRelease(self.raw);
        }
    }
}

fn owned_shader_module(
    raw: types::WGPUShaderModule,
) -> Result<ShaderModule, Error> {
    if c::is_null_mut(raw) {
        Err(Error::ResourceCreationFailed)
    } else {
        Ok(ShaderModule { raw: raw })
    }
}

fn request_adapter_from(
    instance: types::WGPUInstance,
    options: &types::WGPURequestAdapterOptions,
) -> Result<Adapter, Error> {
    let mut status = constants::WGPURequestAdapterStatus_Error;
    let mut adapter: types::WGPUAdapter = c::null<()>();
    let wait_status = unsafe {
        wgpuBridgeRequestAdapter(
            instance,
            options as *const types::WGPURequestAdapterOptions,
            &mut status as *mut types::WGPURequestAdapterStatus,
            &mut adapter as *mut types::WGPUAdapter,
        )
    };
    if wait_status == constants::WGPUWaitStatus_Success
        && status == constants::WGPURequestAdapterStatus_Success
        && !c::is_null_mut(adapter)
    {
        return Ok(Adapter { raw: adapter });
    }
    if !c::is_null_mut(adapter) {
        unsafe {
            api::wgpuAdapterRelease(adapter);
        }
    }
    if wait_status != constants::WGPUWaitStatus_Success {
        Err(Error::WaitFailed)
    } else if status == constants::WGPURequestAdapterStatus_CallbackCancelled {
        Err(Error::AdapterRequestCancelled)
    } else if status == constants::WGPURequestAdapterStatus_Unavailable {
        Err(Error::AdapterUnavailable)
    } else {
        Err(Error::AdapterRequestFailed)
    }
}

fn check_mapping_status(
    wait_status: types::WGPUWaitStatus,
    status: types::WGPUMapAsyncStatus,
) -> Result<(), Error> {
    if wait_status != constants::WGPUWaitStatus_Success {
        return Err(Error::WaitFailed);
    }
    if status == constants::WGPUMapAsyncStatus_CallbackCancelled {
        return Err(Error::BufferMapCancelled);
    }
    if status == constants::WGPUMapAsyncStatus_Aborted {
        return Err(Error::BufferMapAborted);
    }
    if status == constants::WGPUMapAsyncStatus_Success {
        Ok(())
    } else {
        Err(Error::BufferMapFailed)
    }
}

fn surface_error(status: types::WGPUSurfaceGetCurrentTextureStatus) -> Error {
    if status == constants::WGPUSurfaceGetCurrentTextureStatus_Timeout {
        Error::SurfaceTimeout
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Outdated {
        Error::SurfaceOutdated
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Lost {
        Error::SurfaceLost
    } else if status == constants::WGPUSurfaceGetCurrentTextureStatus_Occluded {
        Error::SurfaceOccluded
    } else {
        Error::SurfaceFailed
    }
}
