pub const INIT_VIDEO: u32 = 0x0000_0020;
pub const EVENT_QUIT: u32 = 0x0000_0100;
pub const PIXELFORMAT_ARGB8888: u32 = 0x1636_2004;
pub const TEXTUREACCESS_STREAMING: i32 = 1;
pub const SCALEMODE_NEAREST: i32 = 0;

@derive(Default)
@repr(C)
@align(8)
pub struct Event {
    pub kind: u32,
    pub reserved: u32,
    pub padding: [u64; 15],
}

comptime {
    assert(size_of<Event>() == 128);
    assert(align_of<Event>() == 8);
}

@link("SDL3")
extern "C" {
    pub fn SDL_Init(flags: u32) -> bool;
    pub fn SDL_QuitSubSystem(flags: u32);
    pub fn SDL_CreateWindow(
        title: cstr,
        width: i32,
        height: i32,
        flags: u64,
    ) -> *mut ();
    pub fn SDL_DestroyWindow(window: *mut ());
    pub fn SDL_CreateRenderer(
        window: *mut (),
        name: *const u8,
    ) -> *mut ();
    pub fn SDL_DestroyRenderer(renderer: *mut ());
    pub fn SDL_SetRenderVSync(renderer: *mut (), interval: i32) -> bool;
    pub fn SDL_CreateTexture(
        renderer: *mut (),
        format: u32,
        access: i32,
        width: i32,
        height: i32,
    ) -> *mut ();
    pub fn SDL_DestroyTexture(texture: *mut ());
    pub fn SDL_SetTextureScaleMode(texture: *mut (), mode: i32) -> bool;
    pub fn SDL_UpdateTexture(
        texture: *mut (),
        rect: *const u8,
        pixels: *const u8,
        pitch: i32,
    ) -> bool;
    pub fn SDL_RenderTexture(
        renderer: *mut (),
        texture: *mut (),
        source: *const u8,
        destination: *const u8,
    ) -> bool;
    pub fn SDL_RenderPresent(renderer: *mut ()) -> bool;
    pub fn SDL_PollEvent(event: *mut Event) -> bool;
    pub fn SDL_GetKeyboardState(key_count: *mut i32) -> *const bool;
    pub fn SDL_GetMouseState(x: *mut f32, y: *mut f32) -> u32;
    pub fn SDL_LoadFile(file: cstr, data_size: *mut usize) -> *mut u8;
    pub fn SDL_free(memory: *mut u8);
}
