import std::c;

from self::init import GAMEPAD, Subsystems;
import self::raw::constants as constants;
import self::raw::functions as sdl;
import self::raw::types as types;

const JOYSTICK_ID_SIZE: usize = 4;

/// A recoverable gamepad operation failure.
pub enum GamepadError {
    SubsystemNotInitialized,
    EnumerationFailed,
    OpenFailed,
}

/// SDL's stable identifier for one currently connected joystick device.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct GamepadId {
    value: types::SDL_JoystickID,
}

impl GamepadId {
    /// Creates an identifier when `value` is not SDL's invalid zero value.
    pub fn from_raw(value: types::SDL_JoystickID) -> Option<GamepadId> {
        if value == 0 {
            None
        } else {
            Some(GamepadId { value: value })
        }
    }

    /// Returns SDL's underlying joystick identifier.
    pub fn raw(&self) -> types::SDL_JoystickID {
        self.value
    }
}

/// An SDL gamepad axis index.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct GamepadAxis {
    value: types::SDL_GamepadAxis,
}

impl GamepadAxis {
    /// Creates an axis when `value` belongs to SDL's current axis catalog.
    pub fn from_raw(value: types::SDL_GamepadAxis) -> Option<GamepadAxis> {
        if value >= 0 && value < constants::SDL_GAMEPAD_AXIS_COUNT {
            Some(GamepadAxis { value: value })
        } else {
            None
        }
    }

    /// Returns SDL's underlying axis index.
    pub fn raw(&self) -> types::SDL_GamepadAxis {
        self.value
    }
}

/// An SDL gamepad button index without application action mapping.
@derive(Copy, Clone, Debug, Eq, Hash)
pub struct GamepadButton {
    value: types::SDL_GamepadButton,
}

impl GamepadButton {
    /// Creates a button when `value` belongs to SDL's current button catalog.
    pub fn from_raw(value: types::SDL_GamepadButton) -> Option<GamepadButton> {
        if value >= 0 && value < constants::SDL_GAMEPAD_BUTTON_COUNT {
            Some(GamepadButton { value: value })
        } else {
            None
        }
    }

    /// Returns SDL's underlying button index.
    pub fn raw(&self) -> types::SDL_GamepadButton {
        self.value
    }
}

/// One owned snapshot of connected gamepad identifiers.
pub struct GamepadIds {
    subsystems: &Subsystems,
    data: *mut types::SDL_JoystickID,
    len: usize,
}

impl GamepadIds {
    /// Returns the number of identifiers captured by this snapshot.
    pub fn len(&self) -> usize {
        self.len
    }

    /// Returns whether this snapshot contains no connected gamepads.
    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    /// Returns one captured identifier, or `None` outside the snapshot.
    pub fn get(&self, index: usize) -> Option<GamepadId> {
        if index >= self.len {
            return None;
        }
        let address = self.data as usize + index * JOYSTICK_ID_SIZE;
        let value = unsafe { *(address as *const types::SDL_JoystickID) };
        GamepadId::from_raw(value)
    }

    /// Releases the identifier array through SDL's matching allocator.
    pub fn deinit(self) {
        unsafe {
            sdl::SDL_free(self.data as *mut ());
        }
    }
}

/// Captures the currently connected SDL gamepad identifiers.
pub fn list(subsystems: &Subsystems) -> Result<GamepadIds, GamepadError> {
    if !subsystems.contains(GAMEPAD) {
        return Err(GamepadError::SubsystemNotInitialized);
    }
    let mut count: c::Int = 0;
    let data = unsafe { sdl::SDL_GetGamepads(&mut count as *mut c::Int) };
    if c::is_null_mut(data) || count < 0 {
        if !c::is_null_mut(data) {
            unsafe {
                sdl::SDL_free(data as *mut ());
            }
        }
        Err(GamepadError::EnumerationFailed)
    } else {
        Ok(GamepadIds {
            subsystems: subsystems,
            data: data,
            len: count as usize,
        })
    }
}

/// One owned SDL gamepad handle borrowing the initialized subsystem.
pub struct Gamepad {
    subsystems: &Subsystems,
    raw: *mut types::SDL_Gamepad,
}

impl Gamepad {
    /// Opens one connected gamepad identifier.
    pub fn open(
        subsystems: &Subsystems,
        id: GamepadId,
    ) -> Result<Gamepad, GamepadError> {
        if !subsystems.contains(GAMEPAD) {
            return Err(GamepadError::SubsystemNotInitialized);
        }
        let raw = unsafe { sdl::SDL_OpenGamepad(id.raw()) };
        if c::is_null_mut(raw) {
            Err(GamepadError::OpenFailed)
        } else {
            Ok(Gamepad { subsystems: subsystems, raw: raw })
        }
    }

    /// Returns whether SDL still reports this gamepad as connected.
    pub fn is_connected(&self) -> bool {
        unsafe { sdl::SDL_GamepadConnected(self.raw) }
    }

    /// Returns the current signed value of one gamepad axis.
    pub fn axis(&self, axis: GamepadAxis) -> i16 {
        unsafe { sdl::SDL_GetGamepadAxis(self.raw, axis.raw()) }
    }

    /// Returns whether one gamepad button is currently pressed.
    pub fn is_down(&self, button: GamepadButton) -> bool {
        unsafe { sdl::SDL_GetGamepadButton(self.raw, button.raw()) }
    }

    /// Returns SDL's stable identifier while the handle remains connected.
    pub fn id(&self) -> Option<GamepadId> {
        GamepadId::from_raw(unsafe { sdl::SDL_GetGamepadID(self.raw) })
    }

    /// Returns SDL's borrowed device name when one is available.
    pub fn name(&self) -> Option<cstr> {
        let name = unsafe { sdl::SDL_GetGamepadName(self.raw) };
        if c::is_null(name) {
            None
        } else {
            Some(unsafe { sdl::SDL_GetGamepadName(self.raw) } as cstr)
        }
    }

    /// Returns the non-null native gamepad handle for advanced raw calls.
    pub fn as_raw(&self) -> *mut types::SDL_Gamepad {
        self.raw
    }

    /// Closes the gamepad and releases its subsystem borrow.
    pub fn deinit(self) {
        unsafe {
            sdl::SDL_CloseGamepad(self.raw);
        }
    }
}

